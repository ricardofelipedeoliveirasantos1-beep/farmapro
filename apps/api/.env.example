# ==============================================================================
# FarmaPro API — Configurações de Ambiente (Supabase PostgreSQL Oficial)
# Projeto Supabase: FarmaPro (dbypiyhrvevurlbuseut) | Região: us-east-1
# ==============================================================================

NODE_ENV=development
PORT=3333
API_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Conexão Oficial Supabase PostgreSQL
# ------------------------------------------------------------------------------
# Opção 1: Conexão Direta (Session / Migrations via porta 5432)
DATABASE_URL=postgresql://postgres:[SUA_SENHA_DO_BANCO]@db.dbypiyhrvevurlbuseut.supabase.co:5432/postgres

# Opção 2: Conexão via Pooler Supabase (Transaction Mode porta 6543 - Recomendado para Serverless/Fastify)
# DATABASE_URL=postgresql://postgres.dbypiyhrvevurlbuseut:[SUA_SENHA_DO_BANCO]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Parâmetros segregados de fallback
DB_HOST=db.dbypiyhrvevurlbuseut.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[SUA_SENHA_DO_BANCO]
DB_SSL=true

# ------------------------------------------------------------------------------
# Chaves de Autenticação e SDK Supabase
# ------------------------------------------------------------------------------
SUPABASE_URL=https://dbypiyhrvevurlbuseut.supabase.co
SUPABASE_PUBLISHABLE_KEY=sbp_sua_chave_anon_aqui
SUPABASE_SECRET_KEY=sbp_sua_chave_service_role_aqui

# ------------------------------------------------------------------------------
# Pool de Conexões PostgreSQL
# ------------------------------------------------------------------------------
DB_POOL_MIN=2
DB_POOL_MAX=15
DB_TIMEOUT_MS=10000
