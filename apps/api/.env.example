# ==============================================================================
# FarmaPro API — Variáveis de Ambiente para Desenvolvimento
# ==============================================================================

NODE_ENV=development
PORT=3333
API_HOST=0.0.0.0

# Conexão PostgreSQL Local / Homologação
DATABASE_URL=postgresql://farmapro_app:senha_dev_local@localhost:5432/farmapro_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmapro_dev
DB_USER=farmapro_app
DB_PASSWORD=senha_dev_local
DB_SSL=false

# Pool de conexões
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000
