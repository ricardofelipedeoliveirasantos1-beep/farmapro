{
  "name": "farmapro",
  "version": "0.1.0",
  "private": true,
  "description": "FarmaPro — Plataforma SaaS Profissional de Gestão Farmacêutica",
  "author": "FarmaPro Team",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspace=@farmapro/web dev",
    "dev:api": "npm run --workspace=@farmapro/api dev",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "test": "npm run --workspaces --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
