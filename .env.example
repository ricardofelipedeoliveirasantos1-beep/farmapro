# ==============================================================================
# FarmaPro — Exemplo de Variáveis de Ambiente (.env.example)
# AVISO: Apenas para referência. Nunca insira valores reais ou segredos aqui.
# ==============================================================================

# Configuração da Aplicação
NODE_ENV=development
PORT=3333
API_HOST=0.0.0.0
WEB_PORT=5173

# Frontend (Vite)
VITE_API_URL=http://localhost:3333/api
VITE_APP_NAME="FarmaPro"

# Banco de Dados (PostgreSQL - Planejado)
# Formato: postgresql://[usuario]:[senha]@[host]:[porta]/[banco]?schema=public
DATABASE_URL=""
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="farmapro_dev"
DATABASE_USER=""
DATABASE_PASSWORD=""

# Autenticação e Segurança (JWT)
JWT_SECRET=""
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET=""
REFRESH_TOKEN_EXPIRES_IN="7d"

# Armazenamento e Arquivos (S3 / Local)
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""

# Integrações Fiscais (Futuro - Apenas Nomes Previstos)
FISCAL_ENVIRONMENT="homologacao"

