# ==============================================================================
# FarmaPro — Configurações de Ambiente (Exemplo sem Segredos)
# Copie para .env antes de executar a aplicação em desenvolvimento.
# NUNCA versione credenciais reais de banco ou chaves de produção no Git.
# ==============================================================================

NODE_ENV=development
PORT=3333
API_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Conexão com o Banco de Dados PostgreSQL (Local ou Docker)
# ------------------------------------------------------------------------------
# Opção 1: URL de conexão única
DATABASE_URL=postgresql://farmapro_app:senha_dev_local@localhost:5432/farmapro_dev

# Opção 2: Parâmetros segregados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmapro_dev
DB_USER=farmapro_app
DB_PASSWORD=senha_dev_local
DB_SSL=false

# Configurações do Pool de Conexões
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000
